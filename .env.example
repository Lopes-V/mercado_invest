# Application
APP_ENV=development
LOG_LEVEL=INFO

# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Market data providers
BRAPI_TOKEN=
TWELVE_DATA_API_KEY=

# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=

# Market data schedules
MARKET_QUOTES_ENABLED=false
MARKET_QUOTES_INTERVAL_SECONDS=300
MARKET_HISTORY_ENABLED=false
MARKET_HISTORY_INTERVAL_SECONDS=86400
MARKET_HISTORY_LOOKBACK_DAYS=30
MARKET_HISTORY_CANDLE_INTERVAL=1d

# Automated analysis -> Gemini -> opportunity -> Telegram pipeline
AUTOMATED_PIPELINE_ENABLED=false
AUTOMATED_PIPELINE_INTERVAL_SECONDS=1800
AUTOMATED_PIPELINE_PROVIDERS=brapi,twelve_data
AUTOMATED_PIPELINE_CANDLE_INTERVAL=1d
AUTOMATED_PIPELINE_LOOKBACK_DAYS=30
AUTOMATED_PIPELINE_ANALYSIS_PERIOD=14
AUTOMATED_PIPELINE_REFERENCE_MAX_AGE_SECONDS=345600
AUTOMATED_PIPELINE_PROMPT_VERSION=gemini-v1

# Deterministic opportunity policy. Required when automated pipeline is enabled.
OPPORTUNITY_POLICY_VERSION=
OPPORTUNITY_MINIMUM_CATEGORIES=2
OPPORTUNITY_MAX_AI_WEIGHT=20
OPPORTUNITY_RULES_JSON=

# Alert policy
ALERT_COOLDOWN_SECONDS=86400
